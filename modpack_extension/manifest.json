{
  "manifest_version": 3,
  "name": "Modpack Builder",
  "version": "2.1",
  "description": "Добавляй моды, датапаки, шейдеры и ресурспаки с Modrinth в сборку одним кликом",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": [
    "https://modrinth.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://modrinth.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "add-current": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Добавить открытый проект в сборку"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Modpack Builder",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
